{
  "name": "siam-legends-online",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p . && tsc -p server",
    "db:migrate": "wrangler d1 migrations apply siam-legends-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply siam-legends-db --remote"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
